msgstr "Kunne ikke kontakte Statens vegvesen: %s"

#: includes\class-bv-api.php
msgid "The API key was rejected (401). Check the key and the authorization header."
msgstr "API-nøkkelen ble avvist (401). Sjekk nøkkelen og autorisasjonsheaderen."

#: includes\class-bv-api.php
msgid "Access denied (403). Check the API key."
msgstr "Ingen tilgang (403). Sjekk API-nøkkelen."

#: includes\class-bv-api.php
msgid "The daily quota at Statens vegvesen has been used up (429)."
msgstr "Dagskvoten hos Statens vegvesen er brukt opp (429)."

#: includes\class-bv-api.php
msgid "Error from Statens vegvesen (HTTP %d)."
msgstr "Feil fra Statens vegvesen (HTTP %d)."

